# ==============================
# Environment
# ==============================
APP_ENV=dev

# ==============================
# Development
# ==============================
DEV_DATABASE_URL=postgresql+psycopg://user:pass@host:5432/dbname
DEV_SUPABASE_URL=https://your-dev-project.supabase.co
DEV_SUPABASE_KEY=sb_publishable_xxx
DEV_SUPABASE_ANON_KEY=eyJhbGciOiJI... # optional if DEV_SUPABASE_KEY is set
DEV_SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJI... # server-only

# ==============================
# Production
# ==============================
PROD_DATABASE_URL=postgresql+psycopg://user:pass@host:5432/dbname
PROD_SUPABASE_URL=https://your-prod-project.supabase.co
PROD_SUPABASE_KEY=sb_publishable_xxx
PROD_SUPABASE_ANON_KEY=eyJhbGciOiJI... # optional if PROD_SUPABASE_KEY is set
PROD_SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJI... # server-only

# ==============================
# Optional aliases
# ==============================
# SERVICE_ROLE_KEY can be used as a non-prefixed alias.
# NEXT_PUBLIC_SUPABASE_ANON_KEY is frontend-safe and can be reused by backend config as anon key fallback.
# Never set NEXT_PUBLIC_SUPABASE_SERVICE_ROLE_KEY.
